{
  "mcpServers": {
    "lab-shared": {
      "type": "http",
      "url": "https://LAB-NODE.cluster.lab:8443/mcp",
      "headers": {
        "Authorization": "Bearer ${LAB_SUBSTRATE_TOKEN}"
      }
    },
    "my-personal": {
      "command": ".venv/bin/python",
      "args": ["mcp_server.py"],
      "env": {
        "SUBSTRATE_SCOPE": "personal"
      }
    }
  }
}
